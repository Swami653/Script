# PostgreSQL. На Vercel эти переменные создаёт интеграция Neon,
# локально возьмите строку подключения своей базы или ветки Neon.

# Пулированное соединение (pgbouncer) — используется приложением.
# Для Prisma обязательны параметры pgbouncer=true и connection_limit=1.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Прямое соединение без pgbouncer — нужно миграциям (prisma migrate deploy).
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Секрет для подписи JWT-сессий NextAuth.
# Сгенерировать: `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET="ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"

# Нужно, когда приложение работает за прокси (Vercel выставляет сам).
AUTH_TRUST_HOST="true"

# ── Telegram-уведомления для родителей (все переменные необязательны:
#    без токена события копятся в очереди и никуда не уходят) ────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=""

# Имя бота без @ — для deep-link на памятке (https://t.me/<имя>?start=<код>).
TELEGRAM_BOT_USERNAME=""

# Секрет вебхука: запросы без такого X-Telegram-Bot-Api-Secret-Token получают 401.
# Сгенерировать: `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=""

# Секрет страховочного дренажа /api/notifications/drain (Vercel Cron подставляет
# заголовок Authorization: Bearer <CRON_SECRET> сам, если переменная задана).
CRON_SECRET=""

# Разовая регистрация вебхука после деплоя (подставьте свои значения):
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://school-journal-six.vercel.app/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET&allowed_updates=%5B%22message%22%5D"

# База ссылок в сообщениях бота (по умолчанию — боевой адрес).
# APP_BASE_URL="https://school-journal-six.vercel.app"
