# База данных SQLite (файл создаётся автоматически командой `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT-сессий NextAuth.
# Сгенерировать новый: `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET="ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"

# Базовый URL приложения (нужен NextAuth в production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
