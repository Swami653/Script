// Электронный журнал — схема базы данных
//
// ВАЖНЫЕ ПРАВИЛА ПРЕДМЕТНОЙ ОБЛАСТИ (см. CLAUDE.md):
//  * Оценка (Grade.value) — ЦЕЛОЕ число строго от 1 до 10 (10-балльная система).
//  * Учебный год состоит из 4 четвертей: Lesson.quarter / Grade.quarter ∈ {1,2,3,4}.
//  * Роль хранится строкой, а допустимые значения описаны типом Role
//    в src/lib/roles.ts ("ADMIN" | "TEACHER" | "STUDENT" | "PARENT"): так схема
//    остаётся совместимой и с SQLite (локальная разработка), и с PostgreSQL.

generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x нужен для serverless-среды Vercel (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Пулированное соединение Neon — его использует приложение в рантайме.
  url      = env("DATABASE_URL")
  // Прямое соединение без pgbouncer — нужно миграциям (prisma migrate / db push).
  directUrl = env("DIRECT_URL")
}

/// Пользователь системы: администратор, учитель или ученик.
model User {
  id       String @id @default(cuid())
  /// Логин для входа. Почта не обязательна — школе достаточно логина.
  username String @unique
  /// Необязательная почта (для связи). Уникальна, если указана.
  email    String? @unique
  name     String
  /// bcrypt-хеш пароля. Открытый пароль здесь не хранится никогда.
  password String
  /// Временный пароль, выданный администратором. Виден админу ТОЛЬКО до первого
  /// входа пользователя, после чего затирается (см. src/auth.ts). Это компромисс
  /// между «раздать классу пароли» и безопасностью: постоянные пароли не хранятся.
  tempPassword String?
  /// Момент первого/последнего успешного входа. null — пользователь ещё не входил.
  lastLoginAt DateTime?
  /// Защита от перебора пароля: счётчик неудачных попыток и блокировка до времени.
  failedLoginCount Int @default(0)
  lockedUntil      DateTime?
  /// Инвалидация сессий: увеличивается при смене/сбросе пароля. Кладётся в JWT;
  /// если версия в токене отстала — сессия считается недействительной.
  sessionVersion   Int @default(0)
  /// "ADMIN" | "TEACHER" | "STUDENT" | "PARENT" — валидируется на сервере через src/lib/roles.ts
  role     String @default("STUDENT")
  /// Класс ученика, например "9-А". У администраторов и учителей обычно null.
  className String?
  /// true — пароль выдан автоматически (массовый импорт) и его стоит сменить.
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Учебные периоды, заведённые этим учителем.
  quarterPeriods QuarterPeriod[] @relation("QuarterAuthor")

  /// Оценки, полученные пользователем как учеником.
  grades        Grade[]  @relation("StudentGrades")
  /// Долги (несданные работы) пользователя как ученика.
  debts         Debt[]   @relation("StudentDebts")
  /// Оценки, выставленные пользователем как учителем.
  gradesGiven   Grade[]  @relation("TeacherGrades")
  /// Отметки отсутствия — как у ученика, так и проставленные учителем.
  absences        Absence[] @relation("StudentAbsences")
  absencesMarked  Absence[] @relation("TeacherAbsences")
  /// Безотметочное обучение (1–2 классы): печати, уровни, характеристики —
  /// как у ученика и как у выдавшего их учителя.
  stamps            LessonStamp[] @relation("StudentStamps")
  stampsGiven       LessonStamp[] @relation("TeacherStamps")
  masteryMarks      MasteryMark[] @relation("StudentMastery")
  masteryGiven      MasteryMark[] @relation("TeacherMastery")
  quarterNotes      QuarterNote[] @relation("StudentNotes")
  quarterNotesGiven QuarterNote[] @relation("TeacherNotes")
  /// Уроки, созданные пользователем как учителем.
  lessonsTaught Lesson[] @relation("TeacherLessons")

  /// Отметки «не разобрался в теме», оставленные пользователем как учеником.
  topicConfusions TopicConfusion[] @relation("StudentConfusions")
  /// Семья: связи «родитель → ребёнок», где этот пользователь — родитель.
  parentLinks ParentLink[] @relation("ParentSide")
  /// Связи, где этот пользователь — ребёнок.
  childLinks ParentLink[] @relation("ChildSide")
  /// Привязка Telegram (только для роли PARENT). Одна на пользователя.
  telegramLink       TelegramLink?
  telegramCodes      TelegramLinkCode[]
  notificationEvents NotificationEvent[]

  @@index([role])
  @@index([className])
}

/// Учебный предмет (Математика, Физика, ...). Управляется учителем.
model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lessons      Lesson[]
  grades       Grade[]
  /// Замки закрытых четвертей этого предмета.
  quarterLocks QuarterLock[]
  /// Словесные характеристики за четверть (безотметочные 1–2 классы).
  quarterNotes QuarterNote[]
}

/// Урок = один столбец в журнале: предмет + дата + четверть (+ тема).
model Lesson {
  id        String   @id @default(cuid())
  date      DateTime
  /// Учебный год по его началу: 2025 — это 2025/2026.
  /// Выводится из даты и границ четвертей на сервере, не из пользовательского ввода.
  year      Int
  /// Четверть: 1, 2, 3 или 4.
  quarter   Int
  topic     String?
  /// «Что задано» к ЭТОМУ уроку: ученик готовится к этой дате. null — не записано.
  homework  String?
  /// Пометка планирования: какой тип работы намечен ("control" — контрольная).
  /// Словарь значений — ключи GRADE_KINDS (src/lib/grades.ts); null — обычный урок.
  /// Это план, а не оценка: на средний балл не влияет.
  plannedKind String?
  createdAt DateTime @default(now())
  /// Момент перемещения в корзину. null — живой урок. Журнал, отчёты и экспорт
  /// показывают только живые уроки; урок из корзины можно восстановить или
  /// удалить навсегда (тогда каскадом уйдут его оценки и отметки «Н»).
  deletedAt DateTime?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: SetNull)

  grades   Grade[]
  absences Absence[]
  debts    Debt[]
  /// Безотметочные отметки урока (1–2 классы): печати и уровни освоения.
  stamps       LessonStamp[]
  masteryMarks MasteryMark[]
  /// Отметки учеников «не разобрался в теме» — просьбы объяснить ещё раз.
  confusions TopicConfusion[]

  // Уникальность «один урок на дату по предмету» действует только для живых
  // уроков и живёт в частичном SQL-индексе Lesson_subjectId_date_live_key
  // (см. migrations/4_phase2) — Prisma частичные индексы описывать не умеет,
  // поэтому здесь остаётся обычный индекс для быстрых выборок по дате.
  @@index([subjectId, date])
  @@index([subjectId, year, quarter])
}

/// Ключ-значение для настроек приложения. Сейчас хранит единственный ключ
/// "activeAcademicYear" — учебный год, который видят все пользователи.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Границы четверти в учебном году. Задаёт учитель (раздел «Учебный год»).
model QuarterPeriod {
  id String @id @default(cuid())
  /// Учебный год по его началу: 2025 — это 2025/2026.
  year Int
  /// Четверть: 1, 2, 3 или 4.
  quarter Int
  /// Полночь UTC, как и даты уроков.
  startDate DateTime
  endDate   DateTime

  authorId String?
  author   User?   @relation("QuarterAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, quarter])
  @@index([year])
}

/// Запись журнала изменений (аудита). Хранит СНИМКИ имён, а не связи:
/// запись должна пережить удаление пользователя, урока и предмета,
/// поэтому внешних ключей здесь нет намеренно.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// id автора действия — без связи с User: пользователь может быть удалён.
  actorId   String
  /// Снимок имени автора на момент действия.
  actorName String
  /// Тип действия: "grade.set" | "lesson.delete" | … (см. src/lib/audit-actions.ts).
  action    String
  /// Снимок: ФИО ученика или логин пользователя, которого коснулось действие.
  targetName  String?
  /// Снимок названия предмета, если действие связано с уроком или оценкой.
  subjectName String?
  /// Человекочитаемое описание по-русски: «Математика, урок 12.09: оценка 8…».
  details   String

  @@index([createdAt])
}

/// Отметка отсутствия ученика на уроке («Н»). В средний балл НЕ входит —
/// это учёт посещаемости, а не оценка. Одна отметка на ученика и урок.
model Absence {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("StudentAbsences", fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Денормализованы из урока ради быстрых агрегатов по посещаемости.
  subjectId String
  year      Int
  quarter   Int

  teacherId String?
  teacher   User?   @relation("TeacherAbsences", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId, subjectId, year, quarter])
}

/// Оценка ученика за конкретный урок.
model Grade {
  id String @id @default(cuid())
  /// ЦЕЛОЕ число от 1 до 10. Проверяется зодом на сервере (src/lib/grades.ts).
  value Int
  /// Позиция оценки в ячейке: 0 — первая, 1 — вторая («10/9» за одну контрольную).
  /// Больше двух оценок за урок не допускается — сетка журнала станет нечитаемой.
  slot Int @default(0)
  /// Тип работы: "regular" | "oral" | "homework" | "control" (см. src/lib/grades.ts).
  kind String @default("regular")
  /// Вес оценки в среднем балле. Сейчас все типы работ весят 1 (средний —
  /// обычное арифметическое); поле оставлено для совместимости и на будущее.
  /// Денормализуется из типа на сервере при выставлении.
  weight Int @default(1)
  /// Необязательный комментарий учителя: за что оценка.
  comment String?

  /// Денормализованные поля урока — нужны для быстрых агрегатов.
  /// ИНВАРИАНТ: всегда равны lesson.subjectId, lesson.year и lesson.quarter
  /// (заполняются только из урока, см. src/lib/actions/grades.ts).
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  year      Int
  quarter   Int

  studentId String
  student   User   @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("TeacherGrades", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Штампы «семья ознакомлена». Уходят каскадом вместе с оценкой.
  acks GradeAck[]

  /// У ученика не может быть двух оценок в одной позиции одного урока,
  /// но может быть две оценки за урок в разных позициях (slot 0 и 1).
  @@unique([studentId, lessonId, slot])
  @@index([studentId, subjectId, year, quarter])
  @@index([subjectId, year, quarter])
}

/// Замок четверти по предмету: строка существует = четверть закрыта.
/// Переоткрыть может только ADMIN (reopenQuarterAction) — строка удаляется,
/// снимок QuarterResult уходит каскадом. closedById/closedByName — снимки без FK.
model QuarterLock {
  id           String   @id @default(cuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  year         Int
  quarter      Int
  closedAt     DateTime @default(now())
  closedById   String
  closedByName String

  results QuarterResult[]

  @@unique([subjectId, year, quarter])
  @@index([year, quarter])
}

/// Снимок-ведомость закрытой четверти. Документ: studentId/subjectId — скаляры
/// БЕЗ FK, имя и класс — снимками (паттерн AuditLog), переживает удаление ученика.
/// ИНВАРИАНТ: существует только вместе со своим замком (lockId, onDelete: Cascade).
model QuarterResult {
  id           String      @id @default(cuid())
  lockId       String
  lock         QuarterLock @relation(fields: [lockId], references: [id], onDelete: Cascade)
  studentId    String
  studentName  String
  className    String?
  subjectId    String
  year         Int
  quarter      Int
  average      Float?
  /// Четвертная отметка 1–10; NULL — не аттестован. Считается ТОЛЬКО сервером
  /// через quarterMark() (src/lib/grades.ts) на момент закрытия.
  finalGrade   Int?
  gradeCount   Int
  absenceCount Int
  /// true — строка безотметочного ученика (1–2 класс): в ведомости «б/о», не «н/а».
  gradeless    Boolean     @default(false)
  /// Снимок словесной характеристики на момент закрытия. Документ БЕЗ связи с
  /// живой QuarterNote: переоткрытие удаляет снимок, характеристика остаётся.
  note         String?
  createdAt    DateTime    @default(now())

  @@unique([lockId, studentId])
  @@index([studentId, year])
}

/// Долг ученика за конкретный урок-работу. origin: "auto" (создан syncControlDebts
/// за «Н» на контрольной) | "manual" (пометил учитель). Статус «закрыт оценкой»
/// НЕ хранится — выводится (EXISTS Grade по паре студент+урок); clearedAt —
/// терминальное прощение учителем (строка не удаляется — надгробие).
/// ИНВАРИАНТ: subjectId/year/quarter всегда равны полям урока, заполняются только из lesson.
model Debt {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation("StudentDebts", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  subjectId   String
  year        Int
  quarter     Int
  origin      String    @default("auto")
  note        String?
  createdAt   DateTime  @default(now())
  createdById String?
  clearedAt   DateTime?
  clearedById String?

  @@unique([studentId, lessonId])
  @@index([subjectId, year, quarter])
  @@index([studentId, year])
}

/// Отметка ученика «не разобрался в теме» — просьба объяснить тему урока ещё
/// раз. ПЕРВЫЙ обратный поток данных в журнале: здесь ученик говорит системе,
/// а не система об ученике. Строка существует = просьба живая; снятие отметки —
/// удаление строки (надгробий нет: ребёнок передумал — следа не остаётся,
/// это приватный сигнал, а не документ).
///
/// НЕ оценка и НЕ клетка журнала: в средние баллы не входит, с оценками,
/// «Н» и уровнями не конфликтует (отсутствовавшему тема как раз может быть
/// непонятна). Замок четверти отметку НЕ блокирует — по §1.4 CLAUDE.md замок
/// защищает числа и состав столбцов, а не заметки.
///
/// ПРИВАТНОСТЬ (ядро фичи): отметку видят ТОЛЬКО сам ученик, учитель и
/// администратор. Одноклассникам не отдаётся ни счётчик, ни факт отметки;
/// родителю — ВООБЩЕ ничего (см. getStudentSubjectDetail), иначе ребёнок
/// перестанет нажимать, боясь домашнего разбора.
///
/// subjectId — денормализованный скаляр БЕЗ FK (прецедент Absence/Debt:
/// каскад чистки идёт цепочкой Subject -> Lesson -> TopicConfusion).
/// ИНВАРИАНТ: subjectId/year/quarter всегда равны полям урока, заполняются
/// только из lesson (см. src/lib/actions/confusion.ts). Удаление ученика
/// уносит его отметки каскадом: вне ученика сигнал смысла не имеет.
/// CHECK четверти — только в SQL (migrations/9a, прецедент миграции 7).
model TopicConfusion {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("StudentConfusions", fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  subjectId String
  year      Int
  quarter   Int

  createdAt DateTime @default(now())

  /// Одна отметка на пару «ученик × урок»: повторное нажатие снимает её.
  @@unique([studentId, lessonId])
  @@index([subjectId, year, quarter])
  @@index([studentId, subjectId, year])
}

/// Печать-поощрение за урок (безотметочные 1–2 классы): «Молодец», «Старание»…
/// Печать — НЕ оценка и НИКОГДА не входит в средние баллы. Словарь значений
/// kind — STAMP_KINDS в src/lib/gradeless.ts (без CHECK: словарь расширяемый,
/// прецедент Grade.kind). До MAX_STAMPS_PER_LESSON печатей за урок, каждый
/// вид — один раз (@@unique). subjectId — денормализованный скаляр БЕЗ FK
/// (прецедент Absence/Debt: каскад чистки идёт цепочкой LessonStamp -> Lesson).
/// ИНВАРИАНТ: subjectId/year/quarter всегда равны полям урока, заполняются
/// только из lesson (см. src/lib/actions/gradeless.ts).
model LessonStamp {
  id   String @id @default(cuid())
  kind String

  studentId String
  student   User   @relation("StudentStamps", fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  subjectId String
  year      Int
  quarter   Int

  teacherId String?
  teacher   User?   @relation("TeacherStamps", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // CHECK "quarter" BETWEEN 1 AND 4 живёт только в SQL (migrations/8_gradeless):
  // Prisma CHECK-и не описывает — прецедент миграции 7.
  @@unique([studentId, lessonId, kind])
  @@index([studentId, year])
  @@index([studentId, subjectId, year, quarter])
  @@index([subjectId, year, quarter])
}

/// Уровень освоения за урок (безотметочные 1–2 классы) ВМЕСТО оценки:
/// high / medium / low — словарь MASTERY_LEVELS в src/lib/gradeless.ts.
/// Уровень — НЕ оценка: числового значения не имеет и НИКОГДА не входит в
/// средние баллы. Один на клетку (слотов «10/9» у качественной отметки нет).
/// subjectId — скаляр без FK (прецедент Absence); ИНВАРИАНТ: subjectId/year/
/// quarter всегда из урока. CHECK-и уровня и четверти — только в SQL.
model MasteryMark {
  id      String  @id @default(cuid())
  level   String
  comment String?

  studentId String
  student   User   @relation("StudentMastery", fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  subjectId String
  year      Int
  quarter   Int

  teacherId String?
  teacher   User?   @relation("TeacherMastery", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, subjectId, year, quarter])
  @@index([subjectId, year, quarter])
}

/// Словесная характеристика за четверть по предмету (безотметочные 1–2 классы).
/// К уроку не привязана: год/четверть — первичное измерение, поэтому у subjectId
/// есть FK (каскад чистки предмета — урока-посредника нет). Не оценка, в средние
/// не входит. Замок четверти проверяется через assertQuarterOpen (у действия нет
/// урока для requireWritableLesson). CHECK четверти — только в SQL.
model QuarterNote {
  id   String @id @default(cuid())
  text String

  studentId String
  student   User   @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  year    Int
  quarter Int

  teacherId String?
  teacher   User?   @relation("TeacherNotes", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, year, quarter])
  @@index([studentId, year])
  @@index([subjectId, year, quarter])
}

/// Связь родителя с ребёнком. Создаёт только ADMIN (linkParentAction / createParentAction).
/// ИНВАРИАНТ (на записи + перепроверка на чтении в requireOwnChild):
/// parent.role = "PARENT", student.role = "STUDENT".
model ParentLink {
  id       String @id @default(cuid())
  parentId String
  parent   User   @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("ChildSide", fields: [studentId], references: [id], onDelete: Cascade)

  /// Когда родитель в последний раз открывал дневник ЭТОГО ребёнка —
  /// питает «что нового». Своя у каждого родителя (мама и папа не затирают друг друга).
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  /// Снимок id админа БЕЗ FK (паттерн AuditLog).
  createdById  String?

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// Штамп «Ознакомлен» — цифровая подпись в дневнике. Документ:
/// parentId/parentName — снимки БЕЗ FK (переживает удаление родителя),
/// seenValue — значение оценки, которое родитель видел в момент подписи.
/// «Штамп устарел» НЕ хранится — выводится сравнением seenValue !== grade.value.
model GradeAck {
  id      String @id @default(cuid())
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  parentId   String
  parentName String
  seenValue  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([gradeId, parentId])
  @@index([parentId, createdAt])
}

/// Привязка Telegram-чата. chatId — TEXT: телеграмный int64 не влезает
/// в безопасный диапазон JS number. blockedAt — родитель заблокировал бота
/// (ответ 403 от API); ставится дренажем, сбрасывается при новой привязке.
model TelegramLink {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String    @unique
  createdAt DateTime  @default(now())
  blockedAt DateTime?
}

/// Одноразовый код привязки. В базе ТОЛЬКО SHA-256-хеш — открытый код
/// показывается админу один раз при выдаче (дисциплина tempPassword).
model TelegramLinkCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Outbox уведомлений. Строка на СОБЫТИЕ (не на получателя): получатели
/// резолвятся живыми ParentLink→TelegramLink в момент отправки — отвязка
/// родителя мгновенно глушит поток. Поля-снимки: событие переживает правку
/// и удаление оценки. Комментария учителя здесь НЕТ намеренно (минимизация:
/// что не хранится — не утечёт в мессенджер).
model NotificationEvent {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  subjectName String
  lessonDate  DateTime
  value       Int
  kind        String
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  attempts    Int       @default(0)

  @@index([sentAt, createdAt])
}
