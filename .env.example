# PostgreSQL. На Vercel эти переменные создаёт интеграция Neon,
# локально возьмите строку подключения своей базы или ветки Neon.

# Пулированное соединение (pgbouncer) — используется приложением.
# Для Prisma обязательны параметры pgbouncer=true и connection_limit=1.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Прямое соединение без pgbouncer — нужно миграциям (prisma migrate deploy).
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Секрет для подписи JWT-сессий NextAuth.
# Сгенерировать: `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET="ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"

# Нужно, когда приложение работает за прокси (Vercel выставляет сам).
AUTH_TRUST_HOST="true"
