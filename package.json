{
  "name": "school-journal",
  "version": "1.0.0",
  "private": true,
  "description": "Электронный журнал для школы: 10-балльная система оценок, 4 четверти, роли Администратор / Учитель / Ученик",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/bootstrap.ts",
    "db:reset": "prisma migrate reset --force --skip-generate",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/bootstrap.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/bootstrap.ts && next build",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "0.474.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
